# ── Backend ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL the frontend uses to reach the API (and CORS allowlist)
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# ── Database (same MongoDB as the existing app) ───────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aiblog_generator

# If your local/router DNS can't resolve Atlas (querySrv ECONNREFUSED, or no A record
# for the shard hosts), route the app's DNS through a public resolver instead of changing
# Windows network settings. Set this to true; override servers with DNS_SERVERS if needed.
# FORCE_PUBLIC_DNS=true
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ── Auth ──────────────────────────────────────────────────────────────────
# MUST match the PHP API's jwt_secret so existing users/tokens work.
JWT_SECRET=change-this-to-match-the-php-jwt-secret
JWT_TTL_SECONDS=3600

# ── Encryption ────────────────────────────────────────────────────────────
# Used for server-side Shopify OAuth client secrets + access tokens (AES-256-GCM).
# To interoperate with the PHP backend's encrypted Shopify data, set this to the
# PHP config's `encryption_key` (it falls back to JWT_SECRET if unset).
# APP_ENCRYPTION_KEY=

# ── Shopify OAuth (server-side) ───────────────────────────────────────────
# The redirect URL registered in your Shopify app. Defaults to
# <PUBLIC_API_URL>/api/auth/shopify/callback. Set explicitly if behind a proxy
# whose public URL differs from PUBLIC_API_URL.
# SHOPIFY_OAUTH_REDIRECT_URL=https://your-domain/api/auth/shopify/callback

# ── Redis (queue + websocket pub/sub) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Hardening ─────────────────────────────────────────────────────────────
# Per-IP rate limit (backend is behind nginx; trustProxy uses X-Forwarded-For).
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
# Scheduler worker poll cadence (ms) — how often due jobs are checked.
# SCHEDULER_POLL_INTERVAL_MS=30000

# ── AWS S3 (images + exports) ─────────────────────────────────────────────
# Prefer an IAM role on the instance; otherwise set keys here.
AWS_REGION=eu-central-1
S3_BUCKET=aiblog-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For Lightsail object storage or S3-compatible endpoints, set the endpoint:
# S3_ENDPOINT=

# ── AI providers (server-side; per-user keys still stored in Mongo) ───────
# Optional fallback/global keys:
# OPENAI_API_KEY=
