{
  "name": "blog-generator-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the Blog Generator web platform (loads the deployed web app + auto-update)",
  "author": "List and Sell Ecomerce Team",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.listandsell.aibloggen.desktop",
    "productName": "Blog Generator",
    "copyright": "Copyright © 2026 List and Sell Ecomerce Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": ["main.js", "preload.js", "config.json", "package.json"],
    "publish": [
      {
        "provider": "generic",
        "url": "${env.UPDATE_FEED_URL}"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blog Generator"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    }
  }
}
