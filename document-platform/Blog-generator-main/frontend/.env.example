# Where the frontend reaches the backend API + WebSocket.
#
# Local dev (frontend on :5173, backend on :4000, cross-origin via CORS):
VITE_API_BASE_URL=http://localhost:4000

# Production, served at a DOMAIN ROOT (https://app.example.com), same-origin via nginx:
#   VITE_API_BASE_URL=          # empty → calls /api and /ws on the same origin
#   VITE_BASE_PATH=/

# Production, served under a SUB-PATH (http://3.121.71.76/blog-app/):
#   VITE_API_BASE_URL=/blog-app   # same origin → /blog-app/api + /blog-app/ws
#   VITE_BASE_PATH=/blog-app/     # so built asset URLs resolve under the sub-path

# Optional: shown in Settings → Updates as the web build version.
# VITE_APP_VERSION=1.0.0
