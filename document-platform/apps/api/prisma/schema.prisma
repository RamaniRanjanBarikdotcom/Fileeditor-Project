// ═══════════════════════════════════════════════════════════════
// Document Conversion Platform — Prisma Schema
// ═══════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  ownedOrganizations Organization[] @relation("OrgOwner")
  memberships        OrganizationMember[]
  storedFiles        StoredFile[]
  conversionJobs     ConversionJob[]
  conversionPresets  ConversionPreset[]
  apiKeys            ApiKey[]
  usageRecords       UsageRecord[]
  auditLogs          AuditLog[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─── Organizations ───────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id")
  planId      String?  @map("plan_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner              User                 @relation("OrgOwner", fields: [ownerUserId], references: [id])
  members            OrganizationMember[]
  storedFiles        StoredFile[]
  conversionJobs     ConversionJob[]
  templates          Template[]
  conversionPresets  ConversionPreset[]
  apiKeys            ApiKey[]
  usageRecords       UsageRecord[]
  auditLogs          AuditLog[]

  @@map("organizations")
}

// ─── Organization Members ────────────────────────────────────

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── Stored Files ────────────────────────────────────────────

model StoredFile {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  userId           String            @map("user_id")
  originalFilename String            @map("original_filename")
  storageKey       String            @map("storage_key")
  extension        String
  mimeType         String            @map("mime_type")
  detectedType     String?           @map("detected_type")
  sizeBytes        BigInt            @map("size_bytes")
  sha256           String?
  status           FileStatus        @default(UPLOADING)
  malwareScanStatus MalwareScanStatus @default(PENDING) @map("malware_scan_status")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  expiresAt        DateTime?         @map("expires_at")
  deletedAt        DateTime?         @map("deleted_at")

  // Relations
  organization         Organization    @relation(fields: [organizationId], references: [id])
  user                 User            @relation(fields: [userId], references: [id])
  sourceConversionJobs ConversionJob[] @relation("SourceFile")
  outputConversionJobs ConversionJob[] @relation("OutputFile")

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("stored_files")
}

enum FileStatus {
  UPLOADING
  QUARANTINE
  SCANNING
  CLEAN
  INFECTED
  READY
  EXPIRED
  DELETED
}

enum MalwareScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

// ─── Conversion Jobs ─────────────────────────────────────────

model ConversionJob {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  sourceFileId   String    @map("source_file_id")
  outputFileId   String?   @map("output_file_id")
  sourceFormat   String    @map("source_format")
  targetFormat   String    @map("target_format")
  engine         String?
  engineVersion  String?   @map("engine_version")
  status         JobStatus @default(CREATED)
  progress       Int       @default(0)
  attemptCount   Int       @default(0) @map("attempt_count")
  settingsJson   Json?     @map("settings_json")
  warningJson    Json?     @map("warning_json")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  queuedAt       DateTime? @map("queued_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime? @map("expires_at")

  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  sourceFile      StoredFile        @relation("SourceFile", fields: [sourceFileId], references: [id])
  outputFile      StoredFile?       @relation("OutputFile", fields: [outputFileId], references: [id])
  events          ConversionEvent[]
  usageRecords    UsageRecord[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("conversion_jobs")
}

enum JobStatus {
  CREATED
  UPLOADING
  UPLOADED
  SCANNING
  VALIDATING
  QUEUED
  PROCESSING
  OUTPUT_VALIDATION
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

// ─── Conversion Events ──────────────────────────────────────

model ConversionEvent {
  id              String   @id @default(uuid())
  conversionJobId String   @map("conversion_job_id")
  eventType       String   @map("event_type")
  message         String?
  metadataJson    Json?    @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  conversionJob ConversionJob @relation(fields: [conversionJobId], references: [id], onDelete: Cascade)

  @@index([conversionJobId])
  @@map("conversion_events")
}

// ─── Templates ───────────────────────────────────────────────

model Template {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  templateType   TemplateType @map("template_type")
  storageKey     String       @map("storage_key")
  version        Int          @default(1)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("templates")
}

enum TemplateType {
  DOCX_REFERENCE
  HTML_TEMPLATE
  CSS_STYLESHEET
  HEADER_FOOTER
}

// ─── Conversion Presets ──────────────────────────────────────

model ConversionPreset {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  sourceFormat   String   @map("source_format")
  targetFormat   String   @map("target_format")
  settingsJson   Json     @map("settings_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("conversion_presets")
}

// ─── API Keys ────────────────────────────────────────────────

model ApiKey {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  createdByUserId String    @map("created_by_user_id")
  name            String
  keyHash         String    @map("key_hash")
  permissions     Json?
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@map("api_keys")
}

// ─── Usage Records ───────────────────────────────────────────

model UsageRecord {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  conversionJobId String?  @map("conversion_job_id")
  operation       String
  inputBytes      BigInt?  @map("input_bytes")
  outputBytes     BigInt?  @map("output_bytes")
  processingMs    Int?     @map("processing_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  conversionJob ConversionJob? @relation(fields: [conversionJobId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("usage_records")
}

// ─── Audit Logs ──────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadataJson   Json?    @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
