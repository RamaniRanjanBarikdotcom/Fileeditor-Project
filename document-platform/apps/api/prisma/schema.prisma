// ═══════════════════════════════════════════════════════════════
// ToolSuite — Enterprise Multi-Tool & SaaS Prisma Schema
// ═══════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform Roles & Enums ──────────────────────────────────

enum PlatformRole {
  CUSTOMER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SubscriptionPlanTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum ProductType {
  FREE_TOOL
  SOFTWARE
  AUTOMATION
  SAAS
}

enum CurrencyCode {
  USD
  INR
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum BillingInterval {
  MONTH
  YEAR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EntitlementType {
  LIFETIME_DOWNLOAD
  LICENSE_KEY
  SUBSCRIPTION
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  REVOKED
}

enum ReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum BlogDocumentStatus {
  DRAFT
  READY
  ARCHIVED
  DELETED
}

enum BlogGenerationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BlogExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum BlogDestinationType {
  WORDPRESS
  SHOPIFY
  CUSTOM
  JTL
}

enum BlogPublicationStatus {
  DRAFT
  PUBLISHED
  FAILED
  RETRYING
}

enum BlogScheduleStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum BlogNotificationType {
  GENERATION_COMPLETE
  GENERATION_FAILED
  PUBLISH_SUCCESS
  PUBLISH_FAILED
  SCHEDULE_FAILED
  PROVIDER_FAILURE
  SUBSCRIPTION_LIMIT
  UPSTREAM_RELEASE
}

enum BlogProviderType {
  OPENAI
  GOOGLE
  ANTHROPIC
  OPENROUTER
  GROQ
  XAI
  HUGGINGFACE
  MISTRAL
  TOGETHER
  FIREWORKS
  PERPLEXITY
  SARVAM
  TAVILY
  CUSTOM
}

enum FileStatus {
  UPLOADING
  QUARANTINE
  SCANNING
  CLEAN
  INFECTED
  READY
  EXPIRED
  DELETED
}

enum MalwareScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

enum JobStatus {
  CREATED
  UPLOADING
  UPLOADED
  SCANNING
  VALIDATING
  QUEUED
  PROCESSING
  OUTPUT_VALIDATION
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum TemplateType {
  DOCX_REFERENCE
  HTML_TEMPLATE
  CSS_STYLESHEET
  HEADER_FOOTER
}

enum AiProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MemoryType {
  FACT
  ARCHITECTURE
  DECISION
  REQUIREMENT
  PREFERENCE
  CONSTRAINT
  TASK
  BUG
  STATUS
  INTEGRATION
  CODE_KNOWLEDGE
  SESSION_SUMMARY
  PROJECT_SUMMARY
}

enum MemoryStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
  DELETED
}

enum MemorySourceType {
  AUTO_EXTRACTED
  USER_CREATED
  IMPORTED
  SYSTEM_GENERATED
}

enum MemoryDomain {
  PROJECT_MEMORY
  CODE_KNOWLEDGE
  DOCUMENT_KNOWLEDGE
}

enum MemoryVisibility {
  PROJECT
  USER
}

enum MemoryTrustLevel {
  EXPLICIT
  INTERNAL
  ASSISTANT
  IMPORTED
  EXTERNAL
}

// ─── Users ───────────────────────────────────────────────────

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  passwordHash    String       @map("password_hash")
  firstName       String?      @map("first_name")
  lastName        String?      @map("last_name")
  platformRole    PlatformRole @default(CUSTOMER) @map("platform_role")
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  // Saved Blog Studio colour theme (see BLOG_STUDIO_THEMES); null = not chosen yet.
  blogStudioTheme String?      @map("blog_studio_theme") @db.VarChar(32)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  ownedOrganizations      Organization[]           @relation("OrgOwner")
  memberships             OrganizationMember[]
  refreshSessions         RefreshSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  storedFiles             StoredFile[]
  conversionJobs          ConversionJob[]
  conversionPresets       ConversionPreset[]
  apiKeys                 ApiKey[]
  usageRecords            UsageRecord[]
  auditLogs               AuditLog[]
  orders                  Order[]
  cart                    Cart?
  entitlements            Entitlement[]
  licenses                LicenseKey[]
  quotaReservations       QuotaReservation[]
  downloadLogs            DownloadLog[]
  aiProjects              AiProject[]
  aiConversations         AiConversation[]
  aiMessages              AiMessage[]
  aiMemories              AiMemory[]
  aiSessionSummaries      AiSessionSummary[]
  blogDocuments           BlogDocument[]
  blogGenerationJobs      BlogGenerationJob[]
  blogImages              BlogImage[]
  blogExports             BlogExport[]
  blogPublications        BlogPublication[]        @relation("BlogPublicationCreator")
  blogSchedules           BlogSchedule[]           @relation("BlogScheduleCreator")
  blogCsvImports          BlogCsvImport[]          @relation("BlogCsvImportCreator")
  blogNotifications       BlogNotification[]

  @@map("users")
}

// ─── Auth Tokens & Sessions ──────────────────────────────────

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  familyId  String    @default(uuid()) @map("family_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Organizations & Subscriptions ───────────────────────────

model SubscriptionPlan {
  id               String               @id @default(uuid())
  tier             SubscriptionPlanTier @unique
  name             String
  monthlyOpsLimit  Int                  @map("monthly_ops_limit")
  maxFileSizeBytes BigInt               @map("max_file_size_bytes")
  retentionDays    Int                  @map("retention_days")
  hasApiAccess     Boolean              @default(false) @map("has_api_access")
  maxTeamSeats     Int                  @default(1) @map("max_team_seats")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  organizations Organization[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerUserId String   @map("owner_user_id")
  planId      String?  @map("plan_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner                   User                     @relation("OrgOwner", fields: [ownerUserId], references: [id])
  plan                    SubscriptionPlan?        @relation(fields: [planId], references: [id])
  members                 OrganizationMember[]
  subscriptions           Subscription[]
  storedFiles             StoredFile[]
  conversionJobs          ConversionJob[]
  templates               Template[]
  conversionPresets       ConversionPreset[]
  apiKeys                 ApiKey[]
  usageRecords            UsageRecord[]
  auditLogs               AuditLog[]
  quotaReservations       QuotaReservation[]
  aiProjects              AiProject[]
  aiConversations         AiConversation[]
  aiMessages              AiMessage[]
  aiMemories              AiMemory[]
  aiSessionSummaries      AiSessionSummary[]
  blogDocuments           BlogDocument[]
  blogGenerationJobs      BlogGenerationJob[]
  blogSources             BlogSource[]
  blogImages              BlogImage[]
  blogExports             BlogExport[]
  blogProviderCredentials BlogProviderCredential[]
  blogPromptTemplates     BlogPromptTemplate[]
  blogStudioSetting       BlogStudioSetting?
  blogDestinations        BlogDestination[]
  blogPublications        BlogPublication[]
  blogRemotePosts         BlogRemotePost[]
  blogSchedules           BlogSchedule[]
  blogCsvImports          BlogCsvImport[]
  blogNotifications       BlogNotification[]
  blogStudioPermissions   BlogStudioPermission[]
  blogProductCollections  BlogProductCollection[]
  saasSubscriptions       SaasSubscription[]
  saasUsageWindows        SaasUsageWindow[]
  saasReservations        SaasUsageReservation[]
  saasUsageRecords        SaasUsageRecord[]
  saasUsageCounters       SaasUsageCounter[]
  invBusinesses           InvBusiness[]
  invContacts             InvContact[]
  invItems                InvItem[]
  invDocuments            InvDocument[]
  invWarehouses           InvWarehouse[]
  invRecurringProfiles    InvRecurringProfile[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  planId             String             @map("plan_id")
  provider           PaymentProvider
  providerSubId      String             @unique @map("provider_sub_id")
  status             SubscriptionStatus @default(ACTIVE)
  currency           CurrencyCode
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]

  @@index([organizationId])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  eventType      String   @map("event_type")
  payloadJson    Json     @map("payload_json")
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_events")
}

// ─── Server-Authoritative Tool Registry ───────────────────────

model Tool {
  id               String               @id @default(uuid())
  slug             String               @unique
  name             String
  category         String
  engine           String
  acceptedFormats  String[]             @map("accepted_formats")
  outputFormats    String[]             @map("output_formats")
  minimumPlan      SubscriptionPlanTier @default(FREE) @map("minimum_plan")
  anonymousEnabled Boolean              @default(true) @map("anonymous_enabled")
  costUnits        Int                  @default(1) @map("cost_units")
  maxFileSizeBytes BigInt               @default(10485760) @map("max_file_size_bytes") // default 10MB
  isPublished      Boolean              @default(true) @map("is_published")
  isFeatured       Boolean              @default(false) @map("is_featured")
  sortOrder        Int                  @default(0) @map("sort_order")
  seoMetadata      Json?                @map("seo_metadata")
  configJson       Json?                @map("config_json")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  reservations QuotaReservation[]

  @@index([isPublished, category])
  @@map("tools")
}

// ─── Atomic Quota Reservation ────────────────────────────────

model QuotaReservation {
  id              String            @id @default(uuid())
  idempotencyKey  String            @unique @map("idempotency_key")
  userId          String?           @map("user_id")
  organizationId  String?           @map("organization_id")
  anonymousId     String?           @map("anonymous_id")
  toolId          String            @map("tool_id")
  conversionJobId String?           @map("conversion_job_id")
  unitsReserved   Int               @map("units_reserved")
  status          ReservationStatus @default(RESERVED)
  expiresAt       DateTime          @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  settledAt       DateTime?         @map("settled_at")

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tool          Tool           @relation(fields: [toolId], references: [id])
  conversionJob ConversionJob? @relation(fields: [conversionJobId], references: [id])

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([anonymousId, status])
  @@index([expiresAt, status])
  @@map("quota_reservations")
}

// ─── Commerce, Catalog, Products & Carts ──────────────────────

model Product {
  id           String      @id @default(uuid())
  slug         String      @unique
  name         String
  tagline      String?
  description  String      @db.Text
  type         ProductType
  isPublished  Boolean     @default(false) @map("is_published")
  isFeatured   Boolean     @default(false) @map("is_featured")
  sortOrder    Int         @default(0) @map("sort_order")
  metadataJson Json?       @map("metadata_json")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  prices            Price[]
  releases          ProductRelease[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  entitlements      Entitlement[]
  licenses          LicenseKey[]
  saasSubscriptions SaasSubscription[]
  saasUsageWindows  SaasUsageWindow[]
  saasPlans         SaasPlan[]
  saasUsageCounters SaasUsageCounter[]

  @@index([isPublished, type])
  @@map("products")
}

model Price {
  id               String           @id @default(uuid())
  productId        String           @map("product_id")
  currency         CurrencyCode
  amountMinorUnits Int              @map("amount_minor_units") // cents or paise
  provider         PaymentProvider
  providerPriceId  String?          @map("provider_price_id")
  billingType      BillingType      @default(ONE_TIME) @map("billing_type")
  billingInterval  BillingInterval? @map("billing_interval")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, currency])
  @@map("prices")
}

// ─── Blog Studio SaaS ────────────────────────────────────────

model BlogDocument {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  createdByUserId String             @map("created_by_user_id")
  title           String
  slug            String
  topic           String
  html            String             @db.Text
  editorJson      Json               @map("editor_json")
  metadataJson    Json               @map("metadata_json")
  keywords        String[]           @default([])
  seoScore        Int                @default(0) @map("seo_score")
  language        String
  wordCount       Int                @default(0) @map("word_count")
  status          BlogDocumentStatus @default(DRAFT)
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation(fields: [createdByUserId], references: [id])
  jobs         BlogGenerationJob[]
  sources      BlogSource[]
  images       BlogImage[]
  exports      BlogExport[]
  revisions    BlogRevision[]
  publications BlogPublication[]
  remotePosts  BlogRemotePost[]
  schedules    BlogSchedule[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@map("blog_documents")
}

model BlogGenerationJob {
  id                     String               @id @default(uuid())
  organizationId         String               @map("organization_id")
  userId                 String               @map("user_id")
  blogId                 String?              @map("blog_id")
  inputJson              Json                 @map("input_json")
  checkpointJson         Json?                @map("checkpoint_json")
  parametersSnapshotJson Json?                @map("parameters_snapshot_json")
  promptTemplateVersion  Int?                 @map("prompt_template_version")
  progress               Int                  @default(0)
  currentStage           String?              @map("current_stage")
  model                  String?
  status                 BlogGenerationStatus @default(QUEUED)
  errorCode              String?              @map("error_code")
  errorMessage           String?              @map("error_message")
  cancelRequestedAt      DateTime?            @map("cancel_requested_at")
  startedAt              DateTime?            @map("started_at")
  completedAt            DateTime?            @map("completed_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id])
  blog         BlogDocument?         @relation(fields: [blogId], references: [id], onDelete: SetNull)
  reservation  SaasUsageReservation?
  usageRecords SaasUsageRecord[]

  @@index([organizationId, status, createdAt])
  @@index([userId, createdAt])
  @@map("blog_generation_jobs")
}

model BlogSource {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  blogId         String   @map("blog_id")
  url            String   @db.Text
  title          String
  citationJson   Json?    @map("citation_json")
  retrievedAt    DateTime @map("retrieved_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         BlogDocument @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([organizationId, blogId])
  @@map("blog_sources")
}

model BlogImage {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  blogId          String   @map("blog_id")
  createdByUserId String   @map("created_by_user_id")
  storageKey      String   @map("storage_key")
  mimeType        String   @map("mime_type")
  width           Int
  height          Int
  prompt          String   @db.Text
  altText         String?  @map("alt_text")
  isFeatured      Boolean  @default(false) @map("is_featured")
  credits         Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         BlogDocument @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, blogId])
  @@map("blog_images")
}

model BlogExport {
  id              String           @id @default(uuid())
  organizationId  String           @map("organization_id")
  blogId          String           @map("blog_id")
  createdByUserId String           @map("created_by_user_id")
  format          String
  storageKey      String?          @map("storage_key")
  mimeType        String?          @map("mime_type")
  status          BlogExportStatus @default(QUEUED)
  errorMessage    String?          @map("error_message")
  createdAt       DateTime         @default(now()) @map("created_at")
  completedAt     DateTime?        @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         BlogDocument @relation(fields: [blogId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, blogId, createdAt])
  @@map("blog_exports")
}

// ─── Blog Studio Revisions ───────────────────────────────────

model BlogRevision {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  blogId          String   @map("blog_id")
  createdByUserId String   @map("created_by_user_id")
  version         Int
  title           String
  html            String   @db.Text
  editorJson      Json     @map("editor_json")
  metadataJson    Json?    @map("metadata_json")
  source          String   @default("edit") // edit | generation | regeneration
  createdAt       DateTime @default(now()) @map("created_at")

  blog BlogDocument @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId, version])
  @@map("blog_revisions")
}

// ─── Blog Studio Provider Credentials ────────────────────────

model BlogProviderCredential {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  providerType         BlogProviderType @map("provider_type")
  label                String
  maskedIdentifier     String           @map("masked_identifier")
  encryptedCredential  String           @map("encrypted_credential") @db.Text
  encryptionKeyVersion Int              @default(1) @map("encryption_key_version")
  customEndpoint       String?          @map("custom_endpoint")
  isActive             Boolean          @default(true) @map("is_active")
  lastTestedAt         DateTime?        @map("last_tested_at")
  lastTestSuccess      Boolean?         @map("last_test_success")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerType, label])
  @@index([organizationId, isActive])
  @@map("blog_provider_credentials")
}

// ─── Blog Studio Prompt Templates ────────────────────────────

model BlogPromptTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  stage          String // pipeline stage name
  name           String
  systemPrompt   String   @map("system_prompt") @db.Text
  userPrompt     String   @map("user_prompt") @db.Text
  version        Int      @default(1)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stage, version])
  @@index([organizationId, stage, isDefault])
  @@map("blog_prompt_templates")
}

// ─── Blog Studio Organization Settings ───────────────────────

model BlogStudioSetting {
  id                    String   @id @default(uuid())
  organizationId        String   @unique @map("organization_id")
  defaultTextModel      String?  @map("default_text_model")
  defaultImageModel     String?  @map("default_image_model")
  defaultSearchProvider String?  @map("default_search_provider")
  deepResearchProvider  String?  @map("deep_research_provider")
  enableModelDiscovery  Boolean  @default(false) @map("enable_model_discovery")
  settingsJson          Json?    @map("settings_json")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("blog_studio_settings")
}

// ─── Blog Studio Publishing Destinations ─────────────────────

model BlogDestination {
  id                   String              @id @default(uuid())
  organizationId       String              @map("organization_id")
  type                 BlogDestinationType
  label                String
  endpointUrl          String              @map("endpoint_url")
  encryptedCredential  String?             @map("encrypted_credential") @db.Text
  encryptionKeyVersion Int                 @default(1) @map("encryption_key_version")
  configJson           Json?               @map("config_json")
  isActive             Boolean             @default(true) @map("is_active")
  lastTestedAt         DateTime?           @map("last_tested_at")
  lastTestSuccess      Boolean?            @map("last_test_success")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publications BlogPublication[]
  categoryMaps BlogCategoryMapping[]
  remotePosts  BlogRemotePost[]
  schedules    BlogSchedule[]

  @@unique([organizationId, type, label])
  @@index([organizationId, isActive])
  @@map("blog_destinations")
}

model BlogCategoryMapping {
  id            String   @id @default(uuid())
  destinationId String   @map("destination_id")
  localCategory String   @map("local_category")
  remoteId      String   @map("remote_id")
  remoteName    String   @map("remote_name")
  createdAt     DateTime @default(now()) @map("created_at")

  destination BlogDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, localCategory])
  @@map("blog_category_mappings")
}

// ─── Blog Studio Publications & Remote Posts ─────────────────

model BlogPublication {
  id              String                @id @default(uuid())
  organizationId  String                @map("organization_id")
  blogId          String                @map("blog_id")
  destinationId   String                @map("destination_id")
  createdByUserId String                @map("created_by_user_id")
  status          BlogPublicationStatus @default(DRAFT)
  remotePostId    String?               @map("remote_post_id")
  remoteUrl       String?               @map("remote_url")
  publishedAs     String                @default("draft") @map("published_as") // draft | live
  idempotencyKey  String                @unique @map("idempotency_key")
  attempt         Int                   @default(1)
  errorMessage    String?               @map("error_message")
  metadataJson    Json?                 @map("metadata_json")
  publishedAt     DateTime?             @map("published_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blog         BlogDocument    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  destination  BlogDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("BlogPublicationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, blogId, status])
  @@index([destinationId, status])
  @@map("blog_publications")
}

model BlogRemotePost {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  destinationId  String   @map("destination_id")
  blogId         String?  @map("blog_id")
  remoteId       String   @map("remote_id")
  remoteTitle    String   @map("remote_title")
  remoteUrl      String?  @map("remote_url")
  remoteStatus   String   @map("remote_status") // draft | published | pending | trashed
  lastSyncedAt   DateTime @map("last_synced_at")
  metadataJson   Json?    @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destination  BlogDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  blog         BlogDocument?   @relation(fields: [blogId], references: [id], onDelete: SetNull)

  @@unique([destinationId, remoteId])
  @@index([organizationId, destinationId])
  @@map("blog_remote_posts")
}

// ─── Blog Studio Scheduler ───────────────────────────────────

model BlogSchedule {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  createdByUserId String             @map("created_by_user_id")
  blogId          String?            @map("blog_id")
  destinationId   String?            @map("destination_id")
  jobType         String             @map("job_type") // generate | publish | generate_and_publish
  scheduledAt     DateTime           @map("scheduled_at")
  timezone        String             @default("UTC")
  inputJson       Json?              @map("input_json") // generation parameters when jobType includes generate
  categoryId      String?            @map("category_id")
  generateImages  Boolean            @default(false) @map("generate_images")
  autoPublish     Boolean            @default(false) @map("auto_publish")
  status          BlogScheduleStatus @default(PENDING)
  queueJobId      String?            @map("queue_job_id")
  csvImportId     String?            @map("csv_import_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("BlogScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  blog         BlogDocument?     @relation(fields: [blogId], references: [id], onDelete: SetNull)
  destination  BlogDestination?  @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  csvImport    BlogCsvImport?    @relation(fields: [csvImportId], references: [id], onDelete: SetNull)
  runs         BlogScheduleRun[]

  @@index([organizationId, status, scheduledAt])
  @@index([queueJobId])
  @@map("blog_schedules")
}

model BlogScheduleRun {
  id           String    @id @default(uuid())
  scheduleId   String    @map("schedule_id")
  startedAt    DateTime  @map("started_at")
  completedAt  DateTime? @map("completed_at")
  succeeded    Boolean?
  resultJson   Json?     @map("result_json")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  schedule BlogSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, createdAt])
  @@map("blog_schedule_runs")
}

model BlogCsvImport {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  createdByUserId String   @map("created_by_user_id")
  filename        String
  rowCount        Int      @default(0) @map("row_count")
  validCount      Int      @default(0) @map("valid_count")
  duplicateCount  Int      @default(0) @map("duplicate_count")
  errorCount      Int      @default(0) @map("error_count")
  previewJson     Json?    @map("preview_json")
  validationJson  Json?    @map("validation_json")
  status          String   @default("pending") // pending | validated | importing | completed | failed
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("BlogCsvImportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  schedules    BlogSchedule[]

  @@index([organizationId, createdAt])
  @@map("blog_csv_imports")
}

// ─── Blog Studio Product Context ─────────────────────────────

model BlogProductCollection {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  name             String
  sourceUrl        String?  @map("source_url")
  sourceType       String?  @map("source_type") // auto | shopify | woocommerce | magento | prestashop | bigcommerce | jtl | react | custom
  scrapeConfigJson Json?    @map("scrape_config_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     BlogProduct[]

  @@index([organizationId])
  @@map("blog_product_collections")
}

model BlogProduct {
  id            String    @id @default(uuid())
  collectionId  String    @map("collection_id")
  externalId    String?   @map("external_id")
  title         String
  description   String?   @db.Text
  price         String?
  currency      String?
  imageUrl      String?   @map("image_url")
  productUrl    String?   @map("product_url")
  category      String?
  brand         String?
  fieldsJson    Json?     @map("fields_json")
  lastScrapedAt DateTime? @map("last_scraped_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  collection BlogProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, externalId])
  @@index([collectionId])
  @@map("blog_products")
}

// ─── Blog Studio Notifications ───────────────────────────────

model BlogNotification {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  userId         String?              @map("user_id")
  type           BlogNotificationType
  title          String
  message        String
  resourceType   String?              @map("resource_type")
  resourceId     String?              @map("resource_id")
  readAt         DateTime?            @map("read_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, createdAt])
  @@map("blog_notifications")
}

// ─── Blog Studio Permissions ─────────────────────────────────

model BlogStudioPermission {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  roleOrUserId   String   @map("role_or_user_id") // org role name or user id
  action         String // generate | edit | delete | export | publish | schedule | integrations | provider_keys | prompts | analytics | logs
  allowed        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, roleOrUserId, action])
  @@index([organizationId])
  @@map("blog_studio_permissions")
}

model SaasSubscription {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  productId          String             @map("product_id")
  provider           PaymentProvider
  providerSubId      String             @unique @map("provider_sub_id")
  status             SubscriptionStatus @default(INCOMPLETE)
  currency           CurrencyCode
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Plan bought (generic SaaS plans). Null for legacy single-price add-ons.
  planId String? @map("plan_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  plan         SaasPlan?    @relation(fields: [planId], references: [id])

  @@unique([organizationId, productId])
  @@index([organizationId, status])
  @@map("saas_subscriptions")
}

// ─── Generic SaaS plans (shared by every SaaS app) ─────────────

/// A tier of a SaaS product (e.g. free / pro / business). Limits are data so
/// plans can change without code: { "invoicesPerMonth": 20, "items": 100 }.
/// A limit of -1 means unlimited; a missing metric means not included (0).
model SaasPlan {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  key          String   @db.VarChar(40)
  name         String
  description  String?
  sortOrder    Int      @default(0) @map("sort_order")
  isPublic     Boolean  @default(true) @map("is_public")
  isFree       Boolean  @default(false) @map("is_free")
  limitsJson   Json     @map("limits_json")
  featuresJson Json     @default("[]") @map("features_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices        SaasPlanPrice[]
  subscriptions SaasSubscription[]

  @@unique([productId, key])
  @@map("saas_plans")
}

model SaasPlanPrice {
  id               String          @id @default(uuid())
  planId           String          @map("plan_id")
  currency         CurrencyCode
  interval         BillingInterval
  amountMinorUnits Int             @map("amount_minor_units")
  provider         PaymentProvider
  /// Razorpay plan id (created on first checkout). Stripe uses inline prices.
  providerPriceId  String?         @map("provider_price_id")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")

  plan SaasPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency, interval])
  @@map("saas_plan_prices")
}

/// Metered usage per organization, product, metric and UTC month.
model SaasUsageCounter {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  metric         String   @db.VarChar(60)
  windowStart    DateTime @map("window_start")
  used           Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId, metric, windowStart])
  @@map("saas_usage_counters")
}

model SaasUsageWindow {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  productId       String   @map("product_id")
  windowStart     DateTime @map("window_start")
  windowEnd       DateTime @map("window_end")
  blogLimit       Int      @map("blog_limit")
  creditLimit     Int      @map("credit_limit")
  blogsConsumed   Int      @default(0) @map("blogs_consumed")
  creditsConsumed Int      @default(0) @map("credits_consumed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id])
  reservations SaasUsageReservation[]
  records      SaasUsageRecord[]

  @@unique([organizationId, productId, windowStart])
  @@index([organizationId, windowEnd])
  @@map("saas_usage_windows")
}

model SaasUsageReservation {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  usageWindowId    String            @map("usage_window_id")
  generationJobId  String            @unique @map("generation_job_id")
  estimatedCredits Int               @map("estimated_credits")
  reservesBlog     Boolean           @default(true) @map("reserves_blog")
  status           ReservationStatus @default(RESERVED)
  expiresAt        DateTime          @map("expires_at")
  settledAt        DateTime?         @map("settled_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageWindow   SaasUsageWindow   @relation(fields: [usageWindowId], references: [id], onDelete: Cascade)
  generationJob BlogGenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, expiresAt])
  @@map("saas_usage_reservations")
}

model SaasUsageRecord {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  usageWindowId   String   @map("usage_window_id")
  generationJobId String?  @map("generation_job_id")
  usageType       String   @map("usage_type")
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  imageCount      Int      @default(0) @map("image_count")
  credits         Int      @default(0)
  completedBlogs  Int      @default(0) @map("completed_blogs")
  model           String?
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageWindow   SaasUsageWindow    @relation(fields: [usageWindowId], references: [id], onDelete: Cascade)
  generationJob BlogGenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@unique([generationJobId, usageType])
  @@index([organizationId, createdAt])
  @@map("saas_usage_records")
}

model AiModelPrice {
  id                  String    @id @default(uuid())
  provider            String
  model               String
  version             Int
  inputPerMillionUsd  Decimal   @map("input_per_million_usd") @db.Decimal(12, 6)
  outputPerMillionUsd Decimal   @map("output_per_million_usd") @db.Decimal(12, 6)
  imageUsd            Decimal   @map("image_usd") @db.Decimal(12, 6)
  effectiveFrom       DateTime  @map("effective_from")
  effectiveTo         DateTime? @map("effective_to")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([provider, model, version])
  @@index([provider, model, effectiveFrom])
  @@map("ai_model_prices")
}

model ProductRelease {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  version       String
  changelog     String?  @db.Text
  storageKey    String   @map("storage_key")
  fileSizeBytes BigInt   @map("file_size_bytes")
  fileSha256    String   @map("file_sha256")
  isCurrent     Boolean  @default(false) @map("is_current")
  createdAt     DateTime @default(now()) @map("created_at")

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads DownloadLog[]

  @@index([productId, isCurrent])
  @@map("product_releases")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  priceId   String   @map("price_id")
  createdAt DateTime @default(now()) @map("created_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  price   Price   @relation(fields: [priceId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ─── Orders, Payments & Invoices ─────────────────────────────

model Order {
  id                 String          @id @default(uuid())
  orderNumber        String          @unique @map("order_number")
  userId             String          @map("user_id")
  status             OrderStatus     @default(PENDING)
  currency           CurrencyCode
  totalAmountMinor   Int             @map("total_amount_minor")
  paymentProvider    PaymentProvider @map("payment_provider")
  providerOrderId    String?         @map("provider_order_id")
  providerPaymentId  String?         @map("provider_payment_id")
  providerInvoiceUrl String?         @map("provider_invoice_url")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  items        OrderItem[]
  licenses     LicenseKey[]
  entitlements Entitlement[]

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  productId        String   @map("product_id")
  priceId          String   @map("price_id")
  amountMinorUnits Int      @map("amount_minor_units")
  createdAt        DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  price   Price   @relation(fields: [priceId], references: [id])

  @@map("order_items")
}

// ─── Entitlements, Licenses & Downloads ───────────────────────

model Entitlement {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  productId String          @map("product_id")
  orderId   String?         @map("order_id")
  type      EntitlementType
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, type])
  @@map("entitlements")
}

model LicenseKey {
  id               String        @id @default(uuid())
  keyHash          String        @unique @map("key_hash")
  keyMasked        String        @map("key_masked") // e.g. TOOL-****-****-XXXX
  keyCiphertext    String?       @map("key_ciphertext") // AES-GCM encrypted; never log this value
  productId        String        @map("product_id")
  userId           String        @map("user_id")
  orderId          String?       @map("order_id")
  status           LicenseStatus @default(ACTIVE)
  maxActivations   Int           @default(1) @map("max_activations")
  activationsCount Int           @default(0) @map("activations_count")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  deliveredAt      DateTime?     @map("delivered_at")

  product     Product             @relation(fields: [productId], references: [id])
  user        User                @relation(fields: [userId], references: [id])
  order       Order?              @relation(fields: [orderId], references: [id])
  activations LicenseActivation[]

  @@unique([orderId, productId])
  @@index([userId, productId])
  @@map("license_keys")
}

model LicenseActivation {
  id           String   @id @default(uuid())
  licenseKeyId String   @map("license_key_id")
  machineHash  String   @map("machine_hash")
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  lastPingAt   DateTime @default(now()) @map("last_ping_at")
  createdAt    DateTime @default(now()) @map("created_at")

  licenseKey LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@unique([licenseKeyId, machineHash])
  @@map("license_activations")
}

model DownloadLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  releaseId String   @map("release_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  release ProductRelease @relation(fields: [releaseId], references: [id])

  @@index([userId, releaseId])
  @@map("download_logs")
}

// ─── Webhook Idempotency & Events ────────────────────────────

model WebhookEvent {
  id          String          @id @default(uuid())
  provider    PaymentProvider
  eventId     String          @unique @map("event_id")
  eventType   String          @map("event_type")
  payloadJson Json            @map("payload_json")
  processedAt DateTime?       @map("processed_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([provider, eventId])
  @@map("webhook_events")
}

// ─── Stored Files & Conversion Jobs ──────────────────────────

model StoredFile {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  userId            String            @map("user_id")
  originalFilename  String            @map("original_filename")
  storageKey        String            @map("storage_key")
  extension         String
  mimeType          String            @map("mime_type")
  detectedType      String?           @map("detected_type")
  sizeBytes         BigInt            @map("size_bytes")
  sha256            String?
  status            FileStatus        @default(UPLOADING)
  malwareScanStatus MalwareScanStatus @default(PENDING) @map("malware_scan_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  expiresAt         DateTime?         @map("expires_at")
  deletedAt         DateTime?         @map("deleted_at")

  organization         Organization    @relation(fields: [organizationId], references: [id])
  user                 User            @relation(fields: [userId], references: [id])
  sourceConversionJobs ConversionJob[] @relation("SourceFile")
  outputConversionJobs ConversionJob[] @relation("OutputFile")

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("stored_files")
}

model ConversionJob {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  sourceFileId   String    @map("source_file_id")
  outputFileId   String?   @map("output_file_id")
  sourceFormat   String    @map("source_format")
  targetFormat   String    @map("target_format")
  engine         String?
  engineVersion  String?   @map("engine_version")
  status         JobStatus @default(CREATED)
  progress       Int       @default(0)
  attemptCount   Int       @default(0) @map("attempt_count")
  settingsJson   Json?     @map("settings_json")
  warningJson    Json?     @map("warning_json")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  queuedAt       DateTime? @map("queued_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime? @map("expires_at")

  organization      Organization       @relation(fields: [organizationId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  sourceFile        StoredFile         @relation("SourceFile", fields: [sourceFileId], references: [id])
  outputFile        StoredFile?        @relation("OutputFile", fields: [outputFileId], references: [id])
  events            ConversionEvent[]
  usageRecords      UsageRecord[]
  quotaReservations QuotaReservation[]

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("conversion_jobs")
}

model ConversionEvent {
  id              String   @id @default(uuid())
  conversionJobId String   @map("conversion_job_id")
  eventType       String   @map("event_type")
  message         String?
  metadataJson    Json?    @map("metadata_json")
  createdAt       DateTime @default(now()) @map("created_at")

  conversionJob ConversionJob @relation(fields: [conversionJobId], references: [id], onDelete: Cascade)

  @@index([conversionJobId])
  @@map("conversion_events")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payloadJson   Json         @map("payload_json")
  status        OutboxStatus @default(PENDING)
  attemptCount  Int          @default(0) @map("attempt_count")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  publishedAt   DateTime?    @map("published_at")
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([aggregateType, aggregateId, eventType])
  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model Template {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  templateType   TemplateType @map("template_type")
  storageKey     String       @map("storage_key")
  version        Int          @default(1)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("templates")
}

model ConversionPreset {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  sourceFormat   String   @map("source_format")
  targetFormat   String   @map("target_format")
  settingsJson   Json     @map("settings_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("conversion_presets")
}

model ApiKey {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  createdByUserId String    @map("created_by_user_id")
  name            String
  keyHash         String    @map("key_hash")
  permissions     Json?
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@map("api_keys")
}

model UsageRecord {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  conversionJobId String?  @map("conversion_job_id")
  operation       String
  units           Int      @default(1)
  inputBytes      BigInt?  @map("input_bytes")
  outputBytes     BigInt?  @map("output_bytes")
  processingMs    Int?     @map("processing_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  conversionJob ConversionJob? @relation(fields: [conversionJobId], references: [id])

  @@unique([conversionJobId])
  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("usage_records")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadataJson   Json?    @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Persistent AI Memory ────────────────────────────────────

model AiProject {
  id                    String          @id @default(uuid())
  organizationId        String          @map("organization_id")
  createdByUserId       String          @map("created_by_user_id")
  name                  String
  description           String?         @db.Text
  status                AiProjectStatus @default(ACTIVE)
  memoryEnabled         Boolean         @default(true) @map("memory_enabled")
  autoExtractionEnabled Boolean         @default(true) @map("auto_extraction_enabled")
  summary               String?         @db.Text
  summaryVersion        Int             @default(0) @map("summary_version")
  summaryUpdatedAt      DateTime?       @map("summary_updated_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User               @relation(fields: [createdByUserId], references: [id])
  conversations AiConversation[]
  memories      AiMemory[]
  summaries     AiSessionSummary[]

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@map("ai_projects")
}

model AiConversation {
  id                String               @id @default(uuid())
  organizationId    String               @map("organization_id")
  projectId         String               @map("project_id")
  userId            String               @map("user_id")
  title             String
  status            AiConversationStatus @default(ACTIVE)
  autoMemoryEnabled Boolean              @default(true) @map("auto_memory_enabled")
  lastSummarizedAt  DateTime?            @map("last_summarized_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        AiProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  sourceMemories AiMemory[]
  summaries      AiSessionSummary[]

  @@index([organizationId, projectId, status])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  conversationId String        @map("conversation_id")
  userId         String?       @map("user_id")
  role           AiMessageRole
  content        String        @db.Text
  tokenEstimate  Int           @default(0) @map("token_estimate")
  metadataJson   Json?         @map("metadata_json")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceMemories AiMemory[]

  @@index([organizationId, conversationId, createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiMemory {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  projectId            String           @map("project_id")
  createdByUserId      String           @map("created_by_user_id")
  visibility           MemoryVisibility @default(PROJECT)
  domain               MemoryDomain     @default(PROJECT_MEMORY)
  type                 MemoryType
  title                String
  content              String           @db.Text
  conceptKey           String?          @map("concept_key")
  importance           Float            @default(0.5)
  confidence           Float            @default(0.5)
  status               MemoryStatus     @default(ACTIVE)
  sourceType           MemorySourceType @map("source_type")
  sourceTrust          MemoryTrustLevel @default(INTERNAL) @map("source_trust")
  sourceConversationId String?          @map("source_conversation_id")
  sourceMessageId      String?          @map("source_message_id")
  pinned               Boolean          @default(false)
  embedding            Float[]          @default([])
  embeddingProvider    String?          @map("embedding_provider")
  embeddingModel       String?          @map("embedding_model")
  embeddingVersion     String?          @map("embedding_version")
  metadataJson         Json?            @map("metadata_json")
  lastAccessedAt       DateTime?        @map("last_accessed_at")
  accessCount          Int              @default(0) @map("access_count")
  supersededByMemoryId String?          @map("superseded_by_memory_id")
  deletedAt            DateTime?        @map("deleted_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            AiProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User            @relation(fields: [createdByUserId], references: [id])
  sourceConversation AiConversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      AiMessage?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  supersededBy       AiMemory?       @relation("MemorySupersession", fields: [supersededByMemoryId], references: [id], onDelete: SetNull)
  supersedes         AiMemory[]      @relation("MemorySupersession")

  @@index([organizationId, projectId, status])
  @@index([organizationId, projectId, type, status])
  @@index([organizationId, projectId, conceptKey, status])
  @@index([createdByUserId, visibility, status])
  @@index([updatedAt])
  @@map("ai_memories")
}

model AiSessionSummary {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  projectId        String   @map("project_id")
  conversationId   String   @map("conversation_id")
  userId           String   @map("user_id")
  summary          String   @db.Text
  throughMessageId String?  @map("through_message_id")
  messageCount     Int      @default(0) @map("message_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      AiProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId, createdAt])
  @@index([conversationId, updatedAt])
  @@map("ai_session_summaries")
}

// ─── Invoice Studio + Inventory ────────────────────────────────
// Money and quantities are Decimal; maths lives in @docconv/invoice-engine.
// User ids are stored without foreign keys on purpose: issued invoices are
// legal records and must outlive the account that created them.

/// A selling entity (company or branch with its own tax registration).
model InvBusiness {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  name                String
  legalName           String?   @map("legal_name")
  country             String    @db.VarChar(2)
  /// India: two-digit GST state code.
  stateCode           String?   @map("state_code") @db.VarChar(2)
  addressJson         Json      @default("{}") @map("address_json")
  email               String?
  phone               String?
  website             String?
  /// IN_GST | EU_VAT | GENERIC | NONE
  taxRegime           String    @map("tax_regime") @db.VarChar(16)
  taxId               String?   @map("tax_id")
  gstComposition      Boolean   @default(false) @map("gst_composition")
  currency            String    @db.VarChar(3)
  language            String    @default("en") @db.VarChar(35)
  secondaryLanguage   String?   @map("secondary_language") @db.VarChar(35)
  template            String    @default("classic") @db.VarChar(40)
  accentColor         String?   @map("accent_color") @db.VarChar(7)
  logoStorageKey      String?   @map("logo_storage_key")
  signatureStorageKey String?   @map("signature_storage_key")
  bankJson            Json      @default("{}") @map("bank_json")
  /// none | upi | sepa
  paymentQr           String    @default("none") @map("payment_qr") @db.VarChar(8)
  pricesIncludeTax    Boolean   @default(false) @map("prices_include_tax")
  roundOffTotal       Boolean   @default(false) @map("round_off_total")
  /// BLOCK | WARN | ALLOW
  negativeStockPolicy String    @default("BLOCK") @map("negative_stock_policy") @db.VarChar(8)
  fyStartMonth        Int       @default(1) @map("fy_start_month")
  /// { "TAX_INVOICE": "INV/{FY}/{SEQ:4}", … }
  numberingJson       Json      @default("{}") @map("numbering_json")
  labelOverridesJson  Json      @default("{}") @map("label_overrides_json")
  defaultNotes        String?   @map("default_notes")
  defaultTerms        String?   @map("default_terms")
  defaultDueDays      Int       @default(15) @map("default_due_days")
  /// Days after the due date on which payment reminders are emailed, e.g. [3, 10].
  reminderDaysJson    Json      @default("[3, 10]") @map("reminder_days_json")
  lowStockAlerts      Boolean   @default(true) @map("low_stock_alerts")
  lowStockAlertedOn   DateTime? @map("low_stock_alerted_on") @db.Date
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series       InvSeries[]
  documents    InvDocument[]
  warehouses   InvWarehouse[]

  @@index([organizationId])
  @@map("inv_businesses")
}

/// Number counter per business, document type and period (financial year…).
model InvSeries {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  businessId     String @map("business_id")
  documentType   String @map("document_type") @db.VarChar(40)
  periodKey      String @map("period_key") @db.VarChar(20)
  nextNumber     Int    @default(1) @map("next_number")

  business InvBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, documentType, periodKey])
  @@map("inv_series")
}

/// Customer and/or supplier.
model InvContact {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  isCustomer          Boolean   @default(true) @map("is_customer")
  isSupplier          Boolean   @default(false) @map("is_supplier")
  name                String
  legalName           String?   @map("legal_name")
  email               String?
  phone               String?
  country             String    @db.VarChar(2)
  stateCode           String?   @map("state_code") @db.VarChar(2)
  billingAddressJson  Json      @default("{}") @map("billing_address_json")
  shippingAddressJson Json?     @map("shipping_address_json")
  taxId               String?   @map("tax_id")
  isBusiness          Boolean   @default(true) @map("is_business")
  isSez               Boolean   @default(false) @map("is_sez")
  currency            String?   @db.VarChar(3)
  language            String?   @db.VarChar(35)
  paymentTermsDays    Int?      @map("payment_terms_days")
  notes               String?
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    InvDocument[]

  @@index([organizationId, name])
  @@map("inv_contacts")
}

/// Product (goods) or service.
model InvItem {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  /// GOODS | SERVICES
  kind           String    @default("GOODS") @db.VarChar(10)
  name           String
  description    String?
  sku            String?   @db.VarChar(64)
  barcode        String?   @db.VarChar(64)
  unit           String    @default("pcs") @db.VarChar(16)
  hsnSac         String?   @map("hsn_sac") @db.VarChar(12)
  taxRate        Decimal   @default(0) @map("tax_rate") @db.Decimal(7, 4)
  cessRate       Decimal   @default(0) @map("cess_rate") @db.Decimal(7, 4)
  /// STANDARD | ZERO | EXEMPT | NON_TAXABLE
  taxCategory    String    @default("STANDARD") @map("tax_category") @db.VarChar(16)
  salePrice      Decimal   @default(0) @map("sale_price") @db.Decimal(18, 4)
  purchasePrice  Decimal   @default(0) @map("purchase_price") @db.Decimal(18, 4)
  trackInventory Boolean   @default(false) @map("track_inventory")
  reorderLevel   Decimal?  @map("reorder_level") @db.Decimal(18, 4)
  /// Weighted-average cost across warehouses (inventory valuation).
  averageCost    Decimal   @default(0) @map("average_cost") @db.Decimal(18, 4)
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLevels  InvStockLevel[]
  movements    InvStockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, barcode])
  @@map("inv_items")
}

/// Every sales and purchase document (type from the invoice-engine registry).
model InvDocument {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  businessId           String    @map("business_id")
  documentType         String    @map("document_type") @db.VarChar(40)
  /// DRAFT | ISSUED | PARTIALLY_PAID | PAID | VOID (+ PARTIALLY_RECEIVED | RECEIVED for purchase orders)
  status               String    @default("DRAFT") @db.VarChar(20)
  number               String?   @db.VarChar(40)
  issueDate            DateTime  @map("issue_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  supplyDate           DateTime? @map("supply_date") @db.Date
  contactId            String?   @map("contact_id")
  /// Party details as printed. Re-snapshotted on every draft save; frozen at issue.
  sellerJson           Json      @default("{}") @map("seller_json")
  buyerJson            Json      @default("{}") @map("buyer_json")
  shipToJson           Json?     @map("ship_to_json")
  placeOfSupplyCountry String?   @map("place_of_supply_country") @db.VarChar(2)
  placeOfSupplyState   String?   @map("place_of_supply_state") @db.VarChar(2)
  currency             String    @db.VarChar(3)
  language             String    @db.VarChar(35)
  secondaryLanguage    String?   @map("secondary_language") @db.VarChar(35)
  template             String    @db.VarChar(40)
  pricesIncludeTax     Boolean   @default(false) @map("prices_include_tax")
  reverseCharge        Boolean   @default(false) @map("reverse_charge")
  exportWithPayment    Boolean   @default(false) @map("export_with_payment")
  euOss                Boolean   @default(false) @map("eu_oss")
  roundOffTotal        Boolean   @default(false) @map("round_off_total")
  reference            String?   @db.VarChar(80)
  notes                String?
  terms                String?
  referenceDocumentId  String?   @map("reference_document_id")
  /// Credit notes: return the goods to stock.
  returnToStock        Boolean   @default(false) @map("return_to_stock")
  /// Default warehouse for stock movements of this document.
  warehouseId          String?   @map("warehouse_id")
  /// Stock was moved by this document (so voiding reverses it).
  stockPosted          Boolean   @default(false) @map("stock_posted")
  calculationJson      Json      @default("{}") @map("calculation_json")
  taxableTotal         Decimal   @default(0) @map("taxable_total") @db.Decimal(18, 4)
  taxTotal             Decimal   @default(0) @map("tax_total") @db.Decimal(18, 4)
  grandTotal           Decimal   @default(0) @map("grand_total") @db.Decimal(18, 4)
  amountPaid           Decimal   @default(0) @map("amount_paid") @db.Decimal(18, 4)
  pdfStorageKey        String?   @map("pdf_storage_key")
  pdfSha256            String?   @map("pdf_sha256") @db.VarChar(64)
  issuedAt             DateTime? @map("issued_at")
  issuedByUserId       String?   @map("issued_by_user_id")
  issueIdempotencyKey  String?   @unique @map("issue_idempotency_key") @db.VarChar(80)
  voidedAt             DateTime? @map("voided_at")
  voidReason           String?   @map("void_reason")
  reminderCount        Int       @default(0) @map("reminder_count")
  lastReminderAt       DateTime? @map("last_reminder_at")
  createdByUserId      String    @map("created_by_user_id")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business          InvBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  contact           InvContact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  referenceDocument InvDocument?       @relation("InvDocumentReference", fields: [referenceDocumentId], references: [id], onDelete: Restrict)
  referencedBy      InvDocument[]      @relation("InvDocumentReference")
  lines             InvDocumentLine[]
  payments          InvPayment[]
  shareLinks        InvShareLink[]
  movements         InvStockMovement[]
  receipts          InvGoodsReceipt[]

  @@unique([businessId, documentType, number])
  @@index([organizationId, documentType, status])
  @@index([organizationId, contactId])
  @@index([organizationId, issueDate])
  @@map("inv_documents")
}

model InvDocumentLine {
  id               String   @id @default(uuid())
  documentId       String   @map("document_id")
  position         Int
  itemId           String?  @map("item_id")
  description      String
  details          String?
  hsnSac           String?  @map("hsn_sac") @db.VarChar(12)
  quantity         Decimal  @db.Decimal(18, 4)
  unit             String?  @db.VarChar(16)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 4)
  /// PERCENT | AMOUNT
  discountType     String?  @map("discount_type") @db.VarChar(8)
  discountValue    Decimal? @map("discount_value") @db.Decimal(18, 4)
  taxRate          Decimal  @default(0) @map("tax_rate") @db.Decimal(7, 4)
  cessRate         Decimal  @default(0) @map("cess_rate") @db.Decimal(7, 4)
  taxCategory      String   @default("STANDARD") @map("tax_category") @db.VarChar(16)
  supplyKind       String   @default("GOODS") @map("supply_kind") @db.VarChar(10)
  warehouseId      String?  @map("warehouse_id")
  /// Purchase orders: quantity received so far.
  receivedQuantity Decimal  @default(0) @map("received_quantity") @db.Decimal(18, 4)
  taxable          Decimal  @default(0) @db.Decimal(18, 4)
  taxesJson        Json     @default("[]") @map("taxes_json")
  total            Decimal  @default(0) @db.Decimal(18, 4)

  document InvDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, position])
  @@index([itemId])
  @@map("inv_document_lines")
}

/// Payment recorded against a document (manual in release 1).
model InvPayment {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  documentId      String   @map("document_id")
  paidOn          DateTime @map("paid_on") @db.Date
  amount          Decimal  @db.Decimal(18, 4)
  /// CASH | BANK | UPI | CARD | CHEQUE | OTHER
  method          String   @db.VarChar(10)
  reference       String?  @db.VarChar(80)
  notes           String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  document InvDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([organizationId, paidOn])
  @@index([documentId])
  @@map("inv_payments")
}

/// Public, expiring, revocable link to view and download an issued document.
model InvShareLink {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  documentId     String    @map("document_id")
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  viewCount      Int       @default(0) @map("view_count")
  lastViewedAt   DateTime? @map("last_viewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  document InvDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("inv_share_links")
}

model InvWarehouse {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  businessId     String?   @map("business_id")
  name           String
  code           String?   @db.VarChar(20)
  addressJson    Json      @default("{}") @map("address_json")
  isDefault      Boolean   @default(false) @map("is_default")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business     InvBusiness?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  stockLevels  InvStockLevel[]
  movements    InvStockMovement[]
  receipts     InvGoodsReceipt[]

  @@index([organizationId])
  @@map("inv_warehouses")
}

/// Current quantity per item and warehouse. Always equal to the sum of the
/// item's movements in that warehouse (checked by a reconciliation test).
model InvStockLevel {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  itemId         String   @map("item_id")
  warehouseId    String   @map("warehouse_id")
  onHand         Decimal  @default(0) @map("on_hand") @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  item      InvItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse InvWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([organizationId])
  @@map("inv_stock_levels")
}

/// Append-only stock ledger.
model InvStockMovement {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  itemId         String   @map("item_id")
  warehouseId    String   @map("warehouse_id")
  /// OPENING | SALE | SALE_RETURN | PURCHASE | PURCHASE_RETURN | ADJUSTMENT | TRANSFER_IN | TRANSFER_OUT | REVERSAL
  type           String   @db.VarChar(20)
  /// Signed: positive adds stock, negative removes it.
  quantity       Decimal  @db.Decimal(18, 4)
  unitCost       Decimal? @map("unit_cost") @db.Decimal(18, 4)
  balanceAfter   Decimal  @map("balance_after") @db.Decimal(18, 4)
  documentId     String?  @map("document_id")
  receiptId      String?  @map("receipt_id")
  transferGroup  String?  @map("transfer_group")
  reason         String?
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  item      InvItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse InvWarehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  document  InvDocument?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  receipt   InvGoodsReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([itemId, warehouseId, createdAt])
  @@index([documentId])
  @@map("inv_stock_movements")
}

/// Goods received into a warehouse, usually against a purchase order.
model InvGoodsReceipt {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  purchaseOrderId String?   @map("purchase_order_id")
  warehouseId     String    @map("warehouse_id")
  receivedOn      DateTime  @map("received_on") @db.Date
  supplierRef     String?   @map("supplier_ref") @db.VarChar(80)
  notes           String?
  /// POSTED | CANCELLED
  status          String    @default("POSTED") @db.VarChar(10)
  linesJson       Json      @map("lines_json")
  createdByUserId String    @map("created_by_user_id")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  purchaseOrder InvDocument?       @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     InvWarehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements     InvStockMovement[]

  @@index([organizationId, receivedOn])
  @@index([purchaseOrderId])
  @@map("inv_goods_receipts")
}

/// Repeats an invoice on a schedule (copied from a source document).
model InvRecurringProfile {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  businessId       String    @map("business_id")
  sourceDocumentId String    @map("source_document_id")
  /// WEEKLY | MONTHLY | QUARTERLY | YEARLY
  frequency        String    @db.VarChar(10)
  /// Schedule anchor: run N happens at startOn + N periods (no month-end drift).
  startOn          DateTime  @map("start_on") @db.Date
  nextRunOn        DateTime  @map("next_run_on") @db.Date
  endOn            DateTime? @map("end_on") @db.Date
  autoIssue        Boolean   @default(false) @map("auto_issue")
  emailTo          String?   @map("email_to")
  active           Boolean   @default(true)
  runCount         Int       @default(0) @map("run_count")
  lastRunAt        DateTime? @map("last_run_at")
  lastDocumentId   String?   @map("last_document_id")
  lastError        String?   @map("last_error")
  createdByUserId  String    @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([active, nextRunOn])
  @@index([organizationId])
  @@map("inv_recurring_profiles")
}
