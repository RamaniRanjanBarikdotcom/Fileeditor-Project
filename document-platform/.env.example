# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
DEPLOYMENT_MODE=DOCKER_NATIVE
REDIS_ENABLED=true
PROCESSING_BROWSER_ENABLED=true
PROCESSING_NODE_ENABLED=true
PROCESSING_NATIVE_ENABLED=true
JOB_BACKEND=BULLMQ
APP_URL=http://localhost:5173
API_URL=http://localhost:4201
PUBLIC_WEB_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional idempotent administrator seed. Keep blank in committed templates and
# configure a unique secret through the deployment secret manager.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ALLOW_ADMIN_SEED_IN_PRODUCTION=false

# ─── Transactional email (password reset / verification) ─────
RESEND_API_KEY=
EMAIL_FROM=AppToolkitLab <noreply@apptoolkitlab.com>

# ─── Payments (leave empty to keep checkout disabled) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://docconv:docconv_secret@localhost:5432/docconv?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d
LICENSE_ENCRYPTION_KEY=change-me-to-a-dedicated-license-encryption-secret
# Ed25519 PKCS8 PEM. Required in production when desktop sales are enabled.
LICENSE_SIGNING_PRIVATE_KEY=

# Exact browser origins allowed for checkout completion/cancel redirects.
CHECKOUT_RETURN_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Keep unfinished commercial surfaces disabled until backend enforcement and
# payment/security end-to-end tests are green.
FEATURE_PUBLIC_TOOLS=true
FEATURE_ANONYMOUS_USAGE=true
FEATURE_STORE_CHECKOUT=false
FEATURE_STRIPE=false
FEATURE_RAZORPAY=false
FEATURE_SUBSCRIPTIONS=false
FEATURE_TEAMS=false
FEATURE_API_KEYS=false
FEATURE_BLOG_STUDIO=true
FEATURE_BLOG_STUDIO_CHECKOUT=false
FEATURE_BLOG_STUDIO_IMAGES=true
FEATURE_BLOG_DESKTOP_SALES=false

# Blog Studio full-suite expansion. These defaults make every Studio screen
# available locally. Production deployments should explicitly enable only the
# provider integrations that have valid credentials and passed sandbox tests.
FEATURE_BLOG_STUDIO_FULL_SUITE=true
FEATURE_BLOG_STUDIO_PUBLISHING=true
FEATURE_BLOG_STUDIO_SCHEDULER=true
FEATURE_BLOG_STUDIO_SCRAPING=true
FEATURE_BLOG_STUDIO_BYOK=true
FEATURE_BLOG_STUDIO_SYNC=true
FEATURE_BLOG_STUDIO_ANALYTICS=true

STRIPE_BLOG_STUDIO_PRICE_ID=
RAZORPAY_BLOG_STUDIO_PLAN_ID=
FEATURE_ADMIN_PORTAL=false

# ─── Object Storage (MinIO in dev, R2/S3 in production) ───────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET_QUARANTINE=docconv-quarantine
STORAGE_BUCKET_INPUTS=docconv-inputs
STORAGE_BUCKET_OUTPUTS=docconv-outputs
STORAGE_BUCKET_PREVIEWS=docconv-previews
STORAGE_BUCKET_TEMPLATES=docconv-templates
STORAGE_FORCE_PATH_STYLE=true

# ─── Gotenberg (HTML/Office → PDF) ────────────────────────────
GOTENBERG_URL=http://localhost:3100

# ─── ClamAV (Malware scanning — optional in dev) ──────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false
# Production requires CLAMAV_ENABLED=true and rejects uploads if clamd is down.

# ─── File Limits ───────────────────────────────────────────────
MAX_TRANSPORT_UPLOAD_SIZE_BYTES=262144000
MAX_UPLOAD_SIZE_BYTES=262144000
TEMP_FILE_MAX_TTL_SECONDS=600
TEMP_FILE_CLEANUP_INTERVAL_MS=60000
CONVERSION_TIMEOUT_MS=180000
URL_CONVERSION_TIMEOUT_MS=240000
CHROMIUM_WAIT_DELAY=2s
CHROMIUM_NETWORK_IDLE=2s
MAX_CONVERSION_ATTEMPTS=3

# PDF -> Word: `auto` uses layout reconstruction when pdf2docx is installed and
# falls back to editable text/OCR otherwise. Use `pdf2docx` to require high fidelity.
PDF_TO_DOCX_ENGINE=auto
PDF2DOCX_BIN=pdf2docx
LIBREOFFICE_BIN=libreoffice
DOCX_COMPATIBILITY_VALIDATION_REQUIRED=false

# ─── Anonymous quota identity ──────────────────────────────────
IP_HMAC_SECRET=change-me-to-a-random-secret-before-production

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Persistent AI memory and provider ────────────────────────
# Provider credentials remain server-side. Manual memory, history, search, and
# lexical retrieval continue to work when AI_API_KEY is empty.
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACTION_ENABLED=true
MEMORY_SESSION_SUMMARIES_ENABLED=true
MEMORY_PROJECT_SUMMARIES_ENABLED=true
MEMORY_RECENT_MESSAGE_LIMIT=24
MEMORY_CANDIDATE_LIMIT=200
MEMORY_RETRIEVED_LIMIT=12
MEMORY_MINIMUM_IMPORTANCE=0.55
MEMORY_DUPLICATE_THRESHOLD=0.88
MEMORY_CONFLICT_THRESHOLD=0.72
MEMORY_SUMMARY_MESSAGE_THRESHOLD=24
MEMORY_SESSION_SUMMARY_MESSAGE_INCREMENT=12
MEMORY_PROJECT_SUMMARY_REFRESH_MINUTES=60
MEMORY_RAW_MESSAGE_RETENTION_DAYS=90
MEMORY_SESSION_SUMMARY_RETENTION_DAYS=365
MEMORY_DELETED_RETENTION_DAYS=30
MEMORY_BUDGET_PROJECT_SUMMARY=800
MEMORY_BUDGET_LONG_TERM=2000
MEMORY_BUDGET_SESSION_SUMMARY=700
MEMORY_BUDGET_RECENT_MESSAGES=3000
MEMORY_BUDGET_CODE_CONTEXT=1500
MEMORY_BUDGET_TOTAL=8000
MEMORY_WEIGHT_SEMANTIC=0.45
MEMORY_WEIGHT_IMPORTANCE=0.20
MEMORY_WEIGHT_TASK=0.15
MEMORY_WEIGHT_RECENCY=0.10
MEMORY_WEIGHT_USEFULNESS=0.05
MEMORY_WEIGHT_PINNED=0.05
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-6-luna
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT_MS=60000

# Blog Studio provider and asset settings. Use an independent 32-byte secret in
# production; never reuse JWT or payment secrets. Tavily is optional and only
# enables cited web-source gathering when configured.
BLOG_STUDIO_ENCRYPTION_KEY=
TAVILY_API_KEY=
BLOG_IMAGE_MODEL=gpt-image-2.5-flare
BLOG_IMAGE_CREDITS=4
