# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4201
PUBLIC_WEB_URL=http://localhost:5173
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# ─── Transactional email (password reset / verification) ─────
RESEND_API_KEY=
EMAIL_FROM=AppToolkitLab <noreply@apptoolkitlab.com>

# ─── Payments (leave empty to keep checkout disabled) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://docconv:docconv_secret@localhost:5432/docconv?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Object Storage (MinIO in dev, R2/S3 in production) ───────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET_QUARANTINE=docconv-quarantine
STORAGE_BUCKET_INPUTS=docconv-inputs
STORAGE_BUCKET_OUTPUTS=docconv-outputs
STORAGE_BUCKET_PREVIEWS=docconv-previews
STORAGE_BUCKET_TEMPLATES=docconv-templates
STORAGE_FORCE_PATH_STYLE=true

# ─── Gotenberg (HTML/Office → PDF) ────────────────────────────
GOTENBERG_URL=http://localhost:3100

# ─── ClamAV (Malware scanning — optional in dev) ──────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# ─── File Limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_BYTES=26214400
FILE_RETENTION_HOURS=24
CONVERSION_TIMEOUT_MS=60000
URL_CONVERSION_TIMEOUT_MS=240000
CHROMIUM_WAIT_DELAY=5s
MAX_CONVERSION_ATTEMPTS=3

# ─── Anonymous quota identity ──────────────────────────────────
IP_HMAC_SECRET=change-me-to-a-random-secret-before-production

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=debug
